# Runtime settings: supportpilot/config.py. Process environment takes precedence.
API_KEY=
# Optional chat overrides; omitted values use the defaults in config.py.
SUPPORTPILOT_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORTPILOT_CHAT_MODEL=qwen3.7-plus-2026-05-26

# Embedding service; an empty key falls back to API_KEY.
SUPPORTPILOT_EMBEDDING_API_KEY=
SUPPORTPILOT_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
SUPPORTPILOT_EMBEDDING_MODEL=text-embedding-v4

# Set SUPPORTPILOT_ADMIN_USERS in the process environment after registering.
